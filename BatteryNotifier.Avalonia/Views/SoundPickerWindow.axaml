<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BatteryNotifier.Avalonia.ViewModels"
        mc:Ignorable="d"
        x:Class="BatteryNotifier.Avalonia.Views.SoundPickerWindow"
        x:DataType="vm:SoundPickerViewModel"
        Title="Choose Sound"
        Width="340" Height="350"
        MinWidth="300" MinHeight="350"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Border ClipToBounds="True"
            Background="{DynamicResource AppCardBackground}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,14,16,10"
                Background="{DynamicResource AppHeaderBackground}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding PickerTitle}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Theme="{StaticResource PrimaryButton}"
                        Command="{Binding CancelCommand}"
                        Padding="4" ToolTip.Tip="Close">
                    <PathIcon Data="{StaticResource Icon.X}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource AppSubtleText}" />
                </Button>
            </Grid>
        </Border>

        <!-- Search bar -->
        <Border Grid.Row="1" Padding="12,6,12,4">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="Search sounds..."
                     FontSize="12"
                     Padding="8,6"
                     CornerRadius="8" />
        </Border>

        <!-- Sound list -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" IsVisible="{Binding HasNoResults}">
            <TextBlock Text="Sound not found." FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppSubtleText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="12,0,12,0"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding !HasNoResults}">
            <ItemsControl ItemsSource="{Binding FilteredGroups}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoundPickerGroup">
                        <StackPanel Margin="0,6,0,2">
                            <!-- Group header -->
                            <TextBlock Text="{Binding Title}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppSubtleText}"
                                       Margin="4,0,0,4" />

                            <!-- Sound items -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SoundPickerItem">
                                        <Button x:Name="SoundItemButton"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,1"
                                                CornerRadius="8"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnSoundItemClick">
                                            <Panel>
                                                <!-- Selected-row highlight (data-bound) -->
                                                <Border Background="{DynamicResource AppHoverBackground}"
                                                        CornerRadius="8"
                                                        IsVisible="{Binding IsSelected}" />

                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,8"
                                                      ClipToBounds="True">
                                                    <PathIcon Grid.Column="0"
                                                              Data="{StaticResource Icon.MusicNote}"
                                                              Width="14" Height="14"
                                                              Foreground="{DynamicResource AppSubtleText}"
                                                              Margin="0,0,8,0"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource AppForeground}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               MaxWidth="150"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding DisplayName}" />

                                                    <!-- Persistent "Selected" badge — marks the saved sound, not a tentative click. -->
                                                    <Border Grid.Column="2"
                                                            IsVisible="{Binding IsCurrent}"
                                                            Background="{DynamicResource AppAccentBackground}"
                                                            CornerRadius="8" Padding="6,2" Margin="4,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Selected"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="White" />
                                                    </Border>

                                                    <!-- Play / pause preview (audition on demand; doesn't select) -->
                                                    <Button Grid.Column="3"
                                                            x:Name="PreviewButton"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="5" Margin="2,0"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="Preview"
                                                            Click="OnPreviewToggleClick">
                                                        <Panel Width="12" Height="12">
                                                            <PathIcon Data="{StaticResource Icon.Play}"
                                                                      Width="12" Height="12"
                                                                      Foreground="{DynamicResource AppSubtleText}"
                                                                      IsVisible="{Binding !IsPlaying}" />
                                                            <PathIcon Data="{StaticResource Icon.Pause}"
                                                                      Width="12" Height="12"
                                                                      Foreground="{DynamicResource AppAccentForeground}"
                                                                      IsVisible="{Binding IsPlaying}" />
                                                        </Panel>
                                                    </Button>

                                                    <Button Grid.Column="4"
                                                            x:Name="DeleteButton"
                                                            IsVisible="{Binding IsCustomLibraryItem}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4" Margin="4,0"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="Remove from library"
                                                            Click="OnDeleteCustomClick">
                                                        <PathIcon Data="{StaticResource Icon.X}"
                                                                  Width="10" Height="10"
                                                                  Foreground="{DynamicResource AppSubtleText}" />
                                                    </Button>
                                                </Grid>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="12,10,12,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppCardBorder}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="0"
                        Theme="{StaticResource SecondaryButton}"
                        Command="{Binding ImportSoundCommand}"
                        FontSize="12" Padding="10,6" CornerRadius="8"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Import a sound file into your library">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource Icon.FolderOpen}"
                                  Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Text="Import" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Command="{Binding SelectCommand}"
                        Content="{Binding SelectButtonText}"
                        FontSize="12" Padding="14,6"
                        Background="{DynamicResource AppAccentBackground}"
                        Foreground="White"
                        CornerRadius="8"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Styles>
                        <!-- Keep it accent-colored on hover/press (darker shades) instead of Fluent's gray -->
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark2}" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
